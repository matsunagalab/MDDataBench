{
  "dataset_id": "MDDataBench-v0.3",
  "description": "Short-MD tasks whose reference simulations come from MDDB. Each task is scored on two separate axes: prep (system building, checkable without running MD) and md (the run happened, at the conditions asked for, and its equilibrium statistics are indistinguishable from the reference own windows). Split 70 train / 30 evaluation by homology cluster, so the same system never appears on both sides.",
  "reference_database": {
    "name": "MDDB",
    "url": "https://mddbr.eu/",
    "global_api": "https://mdposit.mddbr.eu/api/rest/v1/",
    "note": "Eight federated nodes; accessions are node-local, so every task carries (node, accession). The global API is not a superset of the nodes.",
    "licence_policy": "The licence string MDDB returns is recorded verbatim. 86 of the hundred are CC BY 4.0 or CC0, 4 are Apache 2.0, and 12 have none recorded and say so in the contract."
  },
